<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050608">

    <!-- WebView for noVNC engine -->
    <WebView
        android:id="@+id/webview_vnc"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top floating pill toolbar -->
    <LinearLayout
        android:id="@+id/layout_web_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:background="@drawable/toolbar_bg"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btn_web_kbd"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="⌨️ Keyboard"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_web_reload"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="🔄 Reload"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_web_close"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="❌ Exit"
            android:textColor="#F87171"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
